  "mixins": [
    "rejuvenation-compat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "fabric-api": ">=0.116.6",
    "minecraft": "1.21.1",
    "java": ">=21",
    "cobblemon": "1.7.3+1.21.1",
    "rejuvenation_fields": ">=${version} <0.2"
  },
  "suggests": {
    "rbrctai": "*",
    "rctapi": "*",
    "cobblemon-battle-extras": "*"
  },
